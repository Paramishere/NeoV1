# .gitignore — NEO AI Desktop Assistant

# ─── Secrets ──────────────────────────────────────────────────
.env
*.key
*.pem

# ─── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
.venv*/
venv/
venv*/
env/
env*/
.Python
build/
dist/
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Database ─────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ─── Node.js ──────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# ─── Frontend build ───────────────────────────────────────────
frontend/dist/
frontend/dist-electron/
frontend/release/
frontend/.vite/

# ─── Logs ─────────────────────────────────────────────────────
logs/
*.log

# ─── AI models (large files) ──────────────────────────────────
/models/
*.gguf
voice/*.bin
voice/*.onnx
voice/*.tflite

# ─── OS ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V7
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── IDE ──────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ─── Memory (user data) ───────────────────────────────────────
memory/

# ─── Electron ─────────────────────────────────────────────────
dist-electron/
