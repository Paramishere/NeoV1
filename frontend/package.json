{
  "name": "neo-desktop",
  "version": "1.0.0",
  "description": "NEO — Futuristic AI Desktop Assistant",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k --names BACKEND,VITE,ELECTRON --prefix-colors yellow,magenta,cyan \"npm run backend:dev\" \"npm run vite:dev\" \"npm run electron:dev\"",
    "vite:dev": "vite",
    "electron:dev": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "backend:dev": "cross-env NODE_ENV=development f:\\NeoV1\\.venv311\\Scripts\\python.exe f:\\NeoV1\\backend\\main.py",
    "build": "vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "ai.neo.desktop",
    "productName": "NEO",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/neo-icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/neo-icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/neo-icon.png"
    }
  }
}
