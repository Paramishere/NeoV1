# ============================================================
# NEO AI Desktop Assistant — Environment Configuration
# ============================================================

# --- Application & Server ---
NEO_VERSION=1.0.0
NEO_ENV=development
NEO_LOG_LEVEL=INFO
NEO_PORT=8765

# --- Database ---
DATABASE_URL=sqlite:///./memory/neo.db

# --- Primary AI: Ollama (Local AI — FREE, NO API KEY REQUIRED) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# --- Optional Cloud AI Keys (Only if you prefer Cloud AI over Local Ollama) ---
GOOGLE_API_KEY=        # Recommended: Free key from Google AI Studio
OPENAI_API_KEY=        # Optional: For GPT-4o models
ANTHROPIC_API_KEY=     # Optional: For Claude models

# --- Local Voice Engine (Free — no key required) ---
VOSK_MODEL_PATH=./voice/vosk-model
PIPER_MODEL_PATH=./voice/piper-model

# --- Security & Developer ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEV_MODE=true
